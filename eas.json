{
  "cli": {
    "version": ">= 7.4.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "android": {
        "buildType": "apk",
        "distribution": "internal"
      },
      "ios": {
        "simulator": false,
        "distribution": "store",
      },
      "environment": "development",
      "env": {
        "GOOGLE_SERVICES_JSON": "./google-services.json",
        "GOOGLE_SERVICES_FILE_IOS": "./GoogleService-Info.plist"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "ios": {
        "distribution": "store"
      },
      "environment": "preview",
      "env": {
        "GOOGLE_SERVICES_JSON": "./google-services.json",
        "GOOGLE_SERVICES_FILE_IOS": "./GoogleService-Info.plist"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease"
      },
      "ios": {
        "distribution": "store"
      },
      "environment": "production",
      "env": {
        "GOOGLE_SERVICES_JSON": "./google-services.json",
        "GOOGLE_SERVICES_FILE_IOS": "./GoogleService-Info.plist"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "email@example.com",
        "ascAppId": "number",
        "appleTeamId": "code"
      }
    },
    "preview": {
      "ios": {
        "appleId": "email@example.com",
        "ascAppId": "number",
        "appleTeamId": "code"
      }
    },
    "development": { 
      "ios": {
        "appleId": "email@example.com",
        "ascAppId": "number",
        "appleTeamId": "code"
      }
    }
  }
}